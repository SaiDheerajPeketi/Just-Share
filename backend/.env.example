PORT=8080
GOOGLE_CLOUD_PROJECT=bb-justshare-android
# Local development only: use Application Default Credentials, or set
# GOOGLE_APPLICATION_CREDENTIALS to a protected file outside the repository.
ANDROID_PACKAGE_NAME=com.blackandblue.justshare
FIREBASE_APP_ID=your-firebase-android-app-id
FREE_TIER_GB=2
PRO_TIER_GB=5
DATA_PACK_GB=10
MAX_RELAY_SESSION_BYTES=5368709120
PUBSUB_PUSH_AUDIENCE=https://api.justshare.blackandblue.co.in/pubsub/rtdn
PUBSUB_PUSH_SERVICE_ACCOUNT=justshare-rtdn-push@bb-justshare-android.iam.gserviceaccount.com
PRO_PRODUCT_ID=pro_unlock
DATA_PACK_PRODUCT_ID=data_pack_10gb
SUPPORT_TIP_PRODUCT_ID=student_developer_tip
# Inject the same 64-character hex value from Secret Manager and the Cloudflare
# Worker secret store. Never commit the value here.
CF_RELAY_HMAC_SECRET=
